# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=todo
DB_PASSWORD=todo
DB_DATABASE=todo

# CORS (comma-separated). Development allows all origins when unset.
# Required in production / Docker Compose so the host browser can call the API.
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
