{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taghvim Task",
  "version": "0.1.0",
  "identifier": "com.plantir.taskcal",
  "build": {
    "frontendDist": "../../frontend/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "yarn --cwd ../frontend dev",
    "beforeBuildCommand": "yarn --cwd ../frontend build"
  },
  "app": {
    "windows": [
      {
        "title": "تقویم تسک",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
