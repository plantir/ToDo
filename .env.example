# Copy to `.env` for Docker Compose. Do not commit `.env`.
#   cp .env.example .env

# Host ports
POSTGRES_PORT=5432
BACKEND_PORT=3333
FRONTEND_PORT=5173

# Postgres (compose service + volume)
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo

# Adonis — local-compose placeholder only.
# Generate a real key before any shared/production use:
#   cd backend && node ace generate:key
APP_KEY=local-compose-placeholder-change-me
APP_URL=http://localhost:3333
LOG_LEVEL=info

# Browser-facing API URL (baked into the frontend image at build time)
PUBLIC_API_URL=http://localhost:3333/api/v1

# Comma-separated browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Backend startup
RUN_MIGRATE=true
RUN_SEED=true
